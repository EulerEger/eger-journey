baseURL: "https://eger-blog.duckdns.org/"
languageCode: "en-us"
title: "Eger's Journey"
theme: "PaperMod"
enableRobotsTXT: true

buildDrafts: false
buildFuture: false
buildExpired: false

# ----------------------------
# Pagination (NEW SYNTAX)
# ----------------------------
pagination:
  pagerSize: 10
  path: page

# ----------------------------
# Site parameters
# ----------------------------
params:
  author: "Elvis.gr"
  description: >
    The journey of a curious mind eager to better understand the inner workings of the universe.

  defaultTheme: auto
  disableThemeToggle: false
  themeSwitch: true
  themeToggleUseExternalJS: false
  # Reading & navigation
  ShowReadingTime: true
  ShowBreadCrumbs: true
  ShowPostNavLinks: true
  ShowShareButtons: false
  ShowCodeCopyButtons: true
  ShowToc: true
  TocOpen: true

  # Homepage header
  homeInfoParams:
    Title: "Scientific Notes & Explorations"
    Content: >
      A self-hosted science and technology blog dedicated to clear explanations,
      rigorous reasoning, and long-term maintainability.

  # Math (KaTeX)
  math: true

  # Local search (no tracking)
  fuseOpts:
    isCaseSensitive: false
    shouldSort: true
    location: 0
    distance: 1000
    threshold: 0.4
    minMatchCharLength: 2
    keys:
      - title
      - summary
      - content

# ----------------------------
# Taxonomies
# ----------------------------
taxonomies:
  category: categories
  tag: tags

# ----------------------------
# Menu
# ----------------------------
menu:
  main:
    - identifier: home
      name: Home
      url: /
      weight: 1

    - identifier: about
      name: About
      url: /about/
      weight: 2

    - identifier: posts
      name: Posts
      url: /posts/
      weight: 3

    - identifier: resources
      name: Resources
      url: /resources/
      weight: 4

    - identifier: contact
      name: Contact
      url: /contact/
      weight: 5

# ----------------------------
# Markup & rendering
# ----------------------------
markup:
  goldmark:
    renderer:
      unsafe: false

  highlight:
    noClasses: false
    style: monokai
    lineNos: true
    tabWidth: 2

  tableOfContents:
    startLevel: 2
    endLevel: 4
    ordered: false

# ----------------------------
# Privacy (UPDATED KEYS)
# ----------------------------
privacy:
  googleAnalytics:
    disable: true

  youtube:
    privacyEnhanced: true

  x:
    enableDNT: true

  vimeo:
    enableDNT: true

# ----------------------------
# Output formats
# ----------------------------
outputs:
  home:
    - HTML
    - RSS
    - JSON

# ----------------------------
# Security
# ----------------------------
security:
  enableInlineShortcodes: true
  exec:
    allow:
      - "^dart-sass-embedded$"
      - "^go$"
      - "^npx$"
  funcs:
    getenv:
      - HUGO_ENV
